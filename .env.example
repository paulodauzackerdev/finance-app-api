# =========================================
# API
# =========================================
PORT=8000
NODE_ENV=development

# =========================================
# PostgreSQL
# =========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass
POSTGRES_DB=financeapp

DATABASE_URL=postgresql://finance_user:finance_pass@localhost:5432/financeapp

# =========================================
# Security
# =========================================
# RATE_LIMIT_MAX=100

# =========================================
# JWT
# =========================================
# Secret key para assinar tokens JWT (mínimo 32 caracteres)
# Gere uma chave segura com: openssl rand -base64 32
# JWT_SECRET=suachaveaqui
# Tempo de expiração do access token (ex: 15m, 1h, 7d)
# JWT_EXPIRES_IN=15m
# Tempo de expiração do refresh token em milissegundos (604800000 = 7 dias)
# JWT_REFRESH_EXPIRES_IN_MS=604800000

# =========================================
# Bcrypt
# =========================================
# BCRYPT_SALT_ROUND=12
